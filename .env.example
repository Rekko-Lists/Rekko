# Select development or production before starting Vite
NODE_ENV=development

# API backend URL
VITE_API_BASE_URL_DEV=http://localhost:5000
VITE_API_BASE_URL_PROD=https://rekko-api.onrender.com

# Firebase (Google OAuth)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Discord OAuth
VITE_DISCORD_CLIENT_ID_DEV=
VITE_DISCORD_CLIENT_ID_PROD=
VITE_DISCORD_REDIRECT_URI_DEV=http://localhost:5173/oauth/discord/callback
VITE_DISCORD_REDIRECT_URI_PROD=https://rekko-lists.vercel.app/oauth/discord/callback
